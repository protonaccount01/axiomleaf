# ─────────────────────────────────────────────────────────────
# Copy to `.env` for local dev.  NEVER commit `.env`.
# On Cloudflare Pages / GitHub Actions add these as build-time
# environment variables / secrets with the exact same names.
# All VITE_* values are embedded in the public JS bundle, so the
# Blogger API key MUST be restricted by HTTP referrer in Google Cloud.
# ─────────────────────────────────────────────────────────────

# Production URL (no trailing slash) – used for canonical + sitemap
VITE_SITE_URL=https://axiomleaf.pages.dev

# Blogger API v3 – https://console.cloud.google.com/apis/credentials
VITE_BLOGGER_API_KEY=
# Blogger → Settings → the number in the dashboard URL (blogID=...)
VITE_BLOGGER_BLOG_ID=
# Optional: public blog URL shown as a fallback link
VITE_BLOGGER_PUBLIC_URL=
